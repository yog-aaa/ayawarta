# Copy to .env.local for Laragon. Never commit a populated environment file.
# Local seed and seed:verify accept only localhost/127.0.0.1/::1:5432/ayawarta.
# A local runtime can explicitly opt into an approved Neon target; local migration/seed remain local-only.
# PostgreSQL
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/ayawarta?schema=public"
# Neon Pooled connection string (used in Vercel Production runtime; optional locally)
# DATABASE_URL_POOLED="postgresql://USER:PASSWORD@ep-PROJECT-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# For an intentionally Neon-backed localhost runtime, set both URLs to the same approved target,
# then uncomment the following values in ignored .env.local. Never use local prisma:* commands on Neon.
# APPROVED_NEON_TARGET_FINGERPRINT="ep-ENDPOINT:database:role"
# AYAWARTA_LOCAL_NEON_RUNTIME="enabled"

# Auth.js and administrator bootstrap
AUTH_SECRET="generate-a-strong-random-secret"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"

# Cloudinary: the public cloud name must match the canonical production catalog.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="uhwi7xvb"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Firebase web client configuration
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-app-id"

# Optional environment and build configuration
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"
NEXT_DISABLE_LIGHTNINGCSS=true
# Optional local HTTP port for pnpm smoke:routes (defaults to 3000).
# PORT=3000
